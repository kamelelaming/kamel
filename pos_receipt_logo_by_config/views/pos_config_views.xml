<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_receipt_logo" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.receipt.logo</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']//div[hasclass('o_settings_container')]" position="inside">
                <setting id="pos_receipt_logo" string="Receipt Logo"
                    help="Optional. POS receipts from this Point of Sale use this logo. Leave it empty to use the company logo.">
                    <field name="pos_receipt_logo" widget="image" class="oe_avatar"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
